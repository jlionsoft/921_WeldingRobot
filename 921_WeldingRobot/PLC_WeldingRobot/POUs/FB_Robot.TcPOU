<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Robot" Id="{a3eff82d-08df-4b38-a2a2-e8191aab9dc7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Robot
VAR
    bStart              : BOOL;
    bReset              : BOOL;
    bStop               : BOOL;
    bMoveFw             : BOOL;
    bMoveBw             : BOOL;
    bWeld AT%Q*         : BOOL;
    bBusy               : BOOL;

    bManMoveFw          : BOOL;
    bManMoveBw          : BOOL;
    bManWeld            : BOOL;

    bRobotReleased      : BOOL;

    fbStepper           : FB_Stepper;
    nState              : E_Mode := eMode_Initial;
    nActiveState        : E_Mode := eMode_Initial;

    nManualModeState    : E_ManualMode := eManual_nothing;
    nSemiAutoState      : E_SemiAutomatic := eSemi_wayBack;

    order               : ST_Order;

    aOrders              : ARRAY [1..10] OF ST_Order :=
    [
        (nTargetTable := 1, tWeldingTime := T#2S),
        (nTargetTable := 4, tWeldingTime := T#4S),
        (nTargetTable := 1, tWeldingTime := T#1s, bWeld := FALSE),
        (nTargetTable := 3, tWeldingTime := T#3S),
        (nTargetTable := 2, tWeldingTime := T#5S),
        (nTargetTable := 0, tWeldingTime := T#2S),
        (nTargetTable := 3, tWeldingTime := T#4s, bWeld := FALSE),
        (nTargetTable := 2, tWeldingTime := T#1MS),
        (nTargetTable := 1, tWeldingTime := T#3S),
        (nTargetTable := 3, tWeldingTime := T#2M)
    ];

    fbWeldingTimer      : TON;
    fbAutoWeldingTimer  : TON;

    nAutomaticState     : E_AutomaticMode := eAuto_reset;
    nCurrentOrder       : INT := 1;

    fbRTrigStart        : R_TRIG;

    nPositionTable1     : INT := 30;
    nPositionTable2     : INT := 45;
    nPositionTable3     : INT := 70;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{6a592d90-bf77-4ece-aa34-9cf072f91431}">
      <Declaration><![CDATA[METHOD Cycle
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbStepper.Cycle();
fbRTrigStart(CLK := bStart);

// Determine the busy status from the currently active operating mode.
// bBusy is calculated at one central location only.
CASE nActiveState OF

    eMode_Manual:
        bBusy := nManualModeState <> eManual_nothing;

    eMode_SemiAutomatic:
        bBusy := nSemiAutoState <> eSemi_ready;

    eMode_FullyAutomatic:
        bBusy := nAutomaticState <> eAuto_ready;

ELSE
    bBusy := FALSE;

END_CASE


// Stop has the highest priority.
IF bStop THEN
    nState := eMode_Stop;
    nActiveState := eMode_Stop;

// Reset has priority over normal mode selection.
ELSIF bReset THEN
    nState := eMode_Reset;
    nActiveState := eMode_Reset;

// Switch to the secure state if conflicting outputs are active.
ELSIF (bMoveFw AND bMoveBw)
   OR (bWeld AND (bMoveFw OR bMoveBw)) THEN

    nState := eMode_Secure;
    nActiveState := eMode_Secure;

// A normal mode change is only accepted while the robot is not busy.
ELSIF (nState <> nActiveState) AND NOT bBusy THEN

    IF fbRTrigStart.Q THEN
        nActiveState := nState;
    END_IF

END_IF


// Always execute the currently active operating mode.
// Do not check bBusy here; a running sequence must continue while busy.
CASE nActiveState OF

    eMode_Secure:
        M_RobotSecure();

    eMode_Reset:
        M_RobotReset();

    eMode_Stop:
        M_RobotStop();

    eMode_Manual:
        M_RobotManualControl();

    eMode_Initial:
        M_RobotInitialSettings();

    eMode_SemiAutomatic:
        M_RobotSemiAutomatic();

    eMode_FullyAutomatic:
        M_Automatic();

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ApproachTable" Id="{7a6bdaf6-9e84-4b59-b1ac-f11cf7e2720d}">
      <Declaration><![CDATA[METHOD M_ApproachTable : BOOL;
VAR_INPUT
	nTargetTable	: INT;
END_VAR
VAR
	bTargetReached	: BOOL;
	nTargetPosition	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//load targetpositions
CASE nTargetTable OF
	1: nTargetPosition := nPositionTable1;
	2: nTargetPosition := nPositionTable2;
	3: nTargetPosition := nPositionTable3;
END_CASE

//approve/move to target position
bTargetReached := fbStepper.M_ApproachPosition(nTargetPosition);

//return (true) when target reached
IF bTargetReached THEN
	M_ApproachTable := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Automatic" Id="{0871b3d5-f802-4d54-ae62-686b0ca1bd1f}">
      <Declaration><![CDATA[METHOD M_Automatic
VAR_INPUT
END_VAR
VAR
	nCount		: INT;
	bOrderFound	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Call the welding timer cyclically.
// Access the order array only while a valid order is being welded.
IF nAutomaticState = eAuto_weld THEN
    fbAutoWeldingTimer(
        IN := TRUE,
        PT := aOrders[nCurrentOrder].tWeldingTime
    );
ELSE
    // Reset the timer outside the welding state.
    // This also avoids an invalid array access at startup
    // when nCurrentOrder is still 0.
    fbAutoWeldingTimer(
        IN := FALSE,
        PT := T#0s
    );
END_IF

CASE nAutomaticState OF

    eAuto_reset:
        // Calibrate the stepper before automatic operation is allowed.
        bWeld := FALSE;

        IF fbStepper.M_Calibrate() THEN
            nAutomaticState := eAuto_ready;
        END_IF

    eAuto_ready:
        // Wait for a rising start signal.
        bWeld := FALSE;

        IF fbRTrigStart.Q THEN
            nAutomaticState := eAuto_searchOrder;
        END_IF

    eAuto_searchOrder:
        // Search the order array for the first valid,
        // not yet completed order.
        bWeld := FALSE;
        bOrderFound := FALSE;

        FOR nCount := 1 TO 10 BY 1 DO

            // Validate target table and welding-time limits.
            aOrders[nCount].bIsValid :=
                (aOrders[nCount].nTargetTable > 0)
                AND (aOrders[nCount].nTargetTable <= 3)
                AND (aOrders[nCount].tWeldingTime > T#100ms)
                AND (aOrders[nCount].tWeldingTime <= T#1m);

            // Select the first valid order that has not been processed yet.
            IF aOrders[nCount].bIsValid
               AND NOT aOrders[nCount].bDone THEN

                bOrderFound := TRUE;
                nCurrentOrder := nCount;

                // Stop searching after the first matching order.
                EXIT;
            END_IF

        END_FOR

        IF bOrderFound THEN
            nAutomaticState := eAuto_approachPosition;
        ELSE
            // No open valid orders are available.
            // Restart calibration before returning to automatic operation.
            nAutomaticState := eAuto_reset;
        END_IF

    eAuto_approachPosition:
        // Move the stepper to the target table of the selected order.
        bWeld := FALSE;

        IF M_ApproachTable(aOrders[nCurrentOrder].nTargetTable) THEN
            nAutomaticState := eAuto_weld;
        END_IF

    eAuto_weld:
        // Mark the current order as completed after welding time elapsed.
        IF fbAutoWeldingTimer.Q THEN
            aOrders[nCurrentOrder].bDone := TRUE;
            nAutomaticState := eAuto_searchOrder;
        END_IF

        // Enable the welding output only if welding is requested
        // by the selected order.
        IF aOrders[nCurrentOrder].bWeld THEN
            bWeld := TRUE;
        ELSE
            bWeld := FALSE;
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RobotInitialSettings" Id="{f02b94eb-ca36-4f08-9d40-bed28dddeb38}">
      <Declaration><![CDATA[METHOD PRIVATE M_RobotInitialSettings
VAR_INPUT
END_VAR

VAR
	bCalibrated: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bCalibrated := fbStepper.M_Calibrate();
IF bCalibrated THEN
	bRobotReleased := FALSE;
	nState := eMode_Secure;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RobotManualControl" Id="{95b77aa7-d422-4297-a6ed-2c9d09c916f8}">
      <Declaration><![CDATA[METHOD PRIVATE M_RobotManualControl
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nManualModeState OF

    // Safe idle state: welding is disabled and the stepper motor is stopped.
    eManual_nothing:
        bWeld := FALSE;
        fbStepper.M_StopEngine();
		// Only allow one manual command at a time to avoid conflicting actions.
		IF bManMoveFw AND NOT bManMoveBw AND NOT bManWeld THEN
			nManualModeState := eManual_forward;

		ELSIF bManMoveBw AND NOT bManMoveFw AND NOT bManWeld THEN
			nManualModeState := eManual_backward;

		ELSIF bManWeld AND NOT bManMoveFw AND NOT bManMoveFw THEN
			nManualModeState := eManual_weld;
		END_IF

    // Keep welding active while the manual weld command is pressed.
    eManual_weld:
        IF bManMoveFw OR bManMoveBw THEN
            nManualModeState := eManual_error;

        ELSIF NOT bManWeld THEN
            nManualModeState := eManual_nothing;
        END_IF

        bWeld := TRUE;

    // Move the stepper motor backward until the command is released.
    eManual_backward:
        bWeld := FALSE;

        IF bManMoveFw OR bManWeld THEN
            nManualModeState := eManual_error;

        ELSIF NOT bManMoveBw THEN
            nManualModeState := eManual_nothing;
        END_IF

        fbStepper.M_MoveBackward();

    // Move the stepper motor forward until the command is released.
    eManual_forward:
        bWeld := FALSE;

        IF bManMoveBw OR bManWeld THEN
            nManualModeState := eManual_error;

        ELSIF NOT bManMoveFw THEN
            nManualModeState := eManual_nothing;
        END_IF

        fbStepper.M_MoveForward();

    // Dont do anything until all variables are false.
    eManual_error:
        bWeld := FALSE;
        fbStepper.M_StopEngine();

        IF NOT bManMoveFw AND NOT bManMoveBw AND NOT bManWeld THEN
            nManualModeState := eManual_nothing;
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RobotReset" Id="{025c426a-3322-494b-accd-1a73acfbe8ac}">
      <Declaration><![CDATA[METHOD PRIVATE M_RobotReset
VAR_INPUT
END_VAR
VAR
	bCalibrated		: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bWeld := FALSE;

bCalibrated := fbStepper.M_Calibrate();

IF bCalibrated THEN
    bRobotReleased := FALSE;
    nState := eMode_Secure;
    nActiveState := eMode_Secure;
END_IF

nAutomaticState := eAuto_reset;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RobotSecure" Id="{3323f2c5-0a5e-45d9-94b4-6d5d5ed9316e}">
      <Declaration><![CDATA[METHOD PRIVATE M_RobotSecure
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bWeld := FALSE;
fbStepper.M_StopEngine();

IF fbRTrigStart.Q THEN
    bRobotReleased := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RobotSemiAutomatic" Id="{7060308a-f815-4853-8798-8e9feecbe29c}">
      <Declaration><![CDATA[METHOD M_RobotSemiAutomatic
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Call the welding timer cyclically.
// The timer runs only while the semi-automatic welding state is active.
fbWeldingTimer(
    IN := nSemiAutoState = eSemi_weld,
    PT := order.tWeldingTime
);

CASE nSemiAutoState OF

	// wait for start
    eSemi_ready:
        // Wait for a rising start signal.
        // Do not start if the current order has already been completed.
        IF fbRTrigStart.Q AND NOT order.bDone THEN
            nSemiAutoState := eSemi_wayThere;
        END_IF
	
	// move to target position
    eSemi_wayThere:
        // Welding must remain disabled while moving to the target table.
        bWeld := FALSE;

        // Move to the table defined by the current order.
        // Continue with welding after the target position is reached.
        IF M_ApproachTable(order.nTargetTable) THEN
            nSemiAutoState := eSemi_weld;
        END_IF
	
	//weld at target position
    eSemi_weld:			
        // Start returning to the home position after the welding time elapsed.
        IF fbWeldingTimer.Q THEN
            nSemiAutoState := eSemi_wayBack;
        END_IF

        // Enable the welding output while the welding state is active.
        bWeld := TRUE;
	
	// move back to home position
    eSemi_wayBack:
        // Disable welding before moving back to the home position.
        bWeld := FALSE;

        // Move the stepper motor back to its home position.
        fbStepper.M_MoveBackward();

        // Mark the order as completed after the home position is reached.
        IF fbStepper.P_Home THEN
            nSemiAutoState := eSemi_ready;
            order.bDone := TRUE;

            // Select the next order index if one is available.
            IF nCurrentOrder <= 3 THEN
                nCurrentOrder := nCurrentOrder + 1;
            END_IF
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RobotStop" Id="{3aafd211-4376-422d-a12b-e789239456ad}">
      <Declaration><![CDATA[METHOD PRIVATE M_RobotStop
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bWeld := FALSE;
fbStepper.M_StopEngine();
bRobotReleased := FALSE;

IF NOT bStop THEN
    nState := eMode_Secure;
    nActiveState := eMode_Secure;
END_IF

nAutomaticState := eAuto_ready;]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_Mode" Id="{16e2b740-90a2-43c3-93b2-7efec441eb44}">
      <Declaration><![CDATA[PROPERTY P_Mode : E_Mode]]></Declaration>
      <Get Name="Get" Id="{de04a5b8-daa4-41ed-a1ab-1d5c0f2d28db}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_Mode := nState;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1ea64e28-ee27-40b6-a2d9-a2c6c66c5f84}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT (bMoveFw OR bMoveBw) THEN
	bWeld := FALSE;
	nState := P_Mode;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>