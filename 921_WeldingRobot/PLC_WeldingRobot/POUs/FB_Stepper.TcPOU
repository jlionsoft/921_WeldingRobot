	bStepSensor		AT%I*	: BOOL;
	bHomingSensor	AT%I*	: BOOL;
	bMoveFw			AT%Q*	: BOOL;
	bMoveBw			AT%Q*	: BOOL;
	nMaxPosition			: INT;
	nCurrentPosition		: INT;
	bHome					: BOOL;
	bBusy					: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{bd28583d-a4b9-4835-ac4e-2fc532d52f52}">
