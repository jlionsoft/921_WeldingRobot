    <Method Name="M_MoveBackward" Id="{003eabef-d4c9-4627-bdd8-0fc5e3154391}">
      <Declaration><![CDATA[METHOD M_MoveBackward
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bMoveBw := TRUE;
bMoveFw := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_MoveForward" Id="{533999ff-536b-435d-ba30-8782be38e1fb}">
      <Declaration><![CDATA[METHOD M_MoveForward
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bMoveBw := FALSE;
bMoveFw := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StopEngine" Id="{a758c370-a0f8-4d6c-b758-d68a8fac8df4}">
      <Declaration><![CDATA[METHOD M_StopEngine
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bMoveBw := FALSE;
bMoveFw := FALSE;]]></ST>
      </Implementation>
    </Method>
